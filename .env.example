# Ambiente: dev | prod. 'prod' proíbe AD_ALLOW_INSECURE.
AMBIENTE=dev

# Active Directory (conta de serviço da API; a API não autentica contas de usuários)
AD_SERVER=ldap://seu-servidor-ad
# Sufixo do userPrincipalName das contas criadas (login@sufixo)
AD_UPN_SUFIXO=londrina.pr.gov.br
AD_BIND_USER=dominio\usuario_servico
AD_BIND_PASSWORD=sua_senha

# Raiz da sub-árvore da API. Precisa estar DENTRO de
# OU=DESENVOL,DC=londrina,DC=pr,DC=gov,DC=br (constante no código); senão a API não sobe.
AD_PML_BASE=OU=PML,OU=DESENVOL,DC=londrina,DC=pr,DC=gov,DC=br

# TLS é obrigatório. O DC de desenvolvimento só fala TLS 1.0 (RSA 1024 / SHA-1) e usa
# LDAPS; a confiança vem do certificado FIXADO. Para ele:
#   AD_SERVER=ldaps://cegonha.londrina.pr.gov.br
#   AD_TLS_CERT_FIXADO=config/tls/cegonha.pem   (PEM público; a API confere antes do bind)
#   AD_TLS_LEGADO=true                          (TLS 1.0; exige AD_TLS_CERT_FIXADO ou AD_TLS_CA_FILE)
#   AD_ALLOW_INSECURE=false
# Alternativa para um DC moderno: AD_TLS_CA_FILE=<CA raiz em PEM> (valida a cadeia e o nome).
AD_ALLOW_INSECURE=false
AD_TLS_CERT_FIXADO=
AD_TLS_LEGADO=false
AD_TLS_CA_FILE=

# TEMPORÁRIO, só em desenvolvimento: enquanto os atributos pml*
# não existirem no schema do AD, PML_GRAVAR=false pula a gravação deles e avisa
# na resposta. AMBIENTE=prod recusa subir com false.
PML_GRAVAR=true

# Logs e trilha de auditoria: tudo fica em LOG_DIR (relativo à raiz do projeto) e nada é apagado.
# O log da aplicação (api_ad.log) e o do uvicorn (uvicorn.log) viram ao mudar o dia ou passar de LOG_MAX_BYTES
# (padrão 50 MB), para api_ad-AAAA-MM-DD.NNN.log. Vazio em API_LOG_FILE, DATABASE_URL e AUDITORIA_CONTINGENCIA_FILE
# = o padrão dentro de LOG_DIR.
LOG_DIR=logs
LOG_MAX_BYTES=52428800
API_LOG_FILE=

# Banco de auditoria (vazio = SQLite em LOG_DIR/ad_audit.db; SQLite relativo vale a partir da raiz do projeto)
DATABASE_URL=

# Autenticação do cliente da API. Todos obrigatórios: a API não sobe sem eles.
# JWT_SECRET_KEY: único e secreto, com ao menos 32 caracteres.
# API_CLIENT_SECRET_HASH: hash do segredo do cliente (o segredo em si nunca vai ao .env).
# Para gerar os dois (e o segredo a entregar ao cliente), com a raiz do projeto como diretório:
#   docker compose run --rm gerar-segredos          (Podman: podman compose run --rm gerar-segredos)
#   python -m app.core.segredo                      (sem container, com o venv ativo)
# Cole as duas linhas impressas aqui, no lugar das abaixo. O hash fica entre aspas simples (tem "$").
JWT_SECRET_KEY=
API_CLIENT_ID=
API_CLIENT_SECRET_HASH=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens de navegador permitidas (CORS), separadas por vírgula. Vazio = nenhuma.
CORS_ALLOW_ORIGINS=

# Auditoria: onde vai o fato quando o resultado de uma ação não pôde ser gravado
# no banco depois de o AD já ter mudado. Uma linha JSON por fato, um arquivo por mês
# (auditoria_contingencia-AAAA-MM.jsonl). Vazio = LOG_DIR/auditoria_contingencia.jsonl.
AUDITORIA_CONTINGENCIA_FILE=

# Limite de falhas em POST /auth/token: acima disso, 429 com Retry-After.
AUTH_MAX_FALHAS=5
AUTH_JANELA_SEGUNDOS=900

# --- Execução em container com HTTPS (docker-compose.yml) -----------------------
# Variáveis lidas pelo Compose (a API as ignora). Todas opcionais; os padrões estão entre parênteses e são os de PRODUÇÃO.
# Dentro do container mantenha LOG_DIR, API_LOG_FILE, DATABASE_URL e AUDITORIA_CONTINGENCIA_FILE VAZIOS
# (o compose fixa LOG_DIR=/app/logs): caminhos do host não valem lá dentro.
# Só o nginx é publicado; a API fica na rede interna do Compose.
# HTTPS_BIND=0.0.0.0                 # interface em que as portas são publicadas (127.0.0.1 = só a própria máquina)
# HTTPS_PORT=443                     # porta pública do HTTPS
# HTTP_PORT=80                       # porta pública do HTTP (só redireciona para o HTTPS)
# REDIRECT_PORT=                     # sufixo de porta no redirecionamento; use :8443 se HTTPS_PORT=8443
# NGINX_SERVER_NAME=_                # nome(s) do servidor, ex.: acesso.londrina.pr.gov.br
# HSTS_MAX_AGE=0                     # Strict-Transport-Security em segundos; em produção 31536000
# API_CERTS_DIR=./.certs              # fullchain.crt e fullchain.key (da CA), atualizados à mão; reinicie o nginx ao trocar
# CERT_FILE=fullchain.crt
# KEY_FILE=fullchain.key
# NGINX_CONF_DIR=./config/nginx      # template do nginx
# NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:stable-alpine
# API_ENV_FILE=.env                  # arquivo de ambiente entregue à API
# API_CONFIG_DIR=./config            # configuração no host (regras.toml, tls/), montada somente leitura
# API_LOGS_DIR=./logs                # logs e auditoria no host, montados com escrita (nginx em logs/nginx)
# API_UID=1000                       # dono dos arquivos de log (id -u / id -g do usuário do host)
# API_GID=1000
# API_IMAGE_TAG=local
# TZ=America/Sao_Paulo               # o log da API vira por dia local
# FORWARDED_ALLOW_IPS=*              # a API só é alcançada pelo nginx, que sobrescreve o X-Forwarded-For
