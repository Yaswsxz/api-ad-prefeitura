# para ".env" e preencha com os dados reais do seu AD

# Use ldaps:// (porta 636) para poder criar usuários, trocar senha e desabilitar contas
AD_SERVER=ldaps://SEU-CONTROLADOR-DE-DOMINIO:636
AD_DOMAIN=prefeitura.local
AD_BASE_DN=DC=prefeitura,DC=local
AD_USER_OU=OU=Funcionarios,DC=prefeitura,DC=local

AD_BIND_USER=svc_api@prefeitura.local
AD_BIND_PASSWORD=

API_SECRET_KEY=
